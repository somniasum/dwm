#!/bin/sh
# ~/.xinitrc  (used by startx, and by GDM through the dwm session entry)

xset r rate 250 40              # fast key repeat
xset s off -dpms                # no screen blanking
xsetroot -solid '#000000'       # fallback if the wallpaper is missing
xsetroot -cursor_name left_ptr  # normal arrow instead of the X-shaped root cursor

# wallpaper: feh paints the root window once and exits (no daemon, no RAM kept)
[ -f "$HOME/.config/wallpaper.png" ] && feh --no-fehbg --bg-fill "$HOME/.config/wallpaper.png" &

# volume item for the bar: write the current value now (PipeWire may need a moment after login)
( i=0; until /usr/local/bin/volume sync; do i=$((i + 1)); [ "$i" -ge 10 ] && break; sleep 1; done ) &

# optional, uncomment what you want:
# /usr/local/bin/volume watch &         # keep [ vol ] in sync with changes made outside the keys
# powerprofilesctl set performance      # CPU favours speed over power saving
# picom -b --backend glx --vsync        # only if you see tearing (costs a little GPU)

slstatus &
exec dwm
